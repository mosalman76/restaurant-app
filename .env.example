# =============================================================================
# Restaurant App — Environment Variables
# Copy this file to .env and fill in your values before running the project.
# NEVER commit the actual .env file — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (used by the db service in docker-compose)
# -----------------------------------------------------------------------------

# Name of the database to create / connect to
POSTGRES_DB=restaurant_db

# PostgreSQL superuser name
POSTGRES_USER=postgres

# PostgreSQL superuser password — change this in any non-local environment
POSTGRES_PASSWORD=change_me_in_production

# -----------------------------------------------------------------------------
# Backend — Node.js / Express
# -----------------------------------------------------------------------------

# Full Prisma connection string; for Docker Compose the host is the service name "db"
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/restaurant_db

# Secret key used to sign and verify JWTs — must be at least 32 random characters
JWT_SECRET=change_me_at_least_32_random_characters

# Runtime environment; affects error detail visibility and Swagger UI availability
# Allowed values: development | test | production
NODE_ENV=development

# TCP port the Express server listens on inside the container
PORT=4000

# -----------------------------------------------------------------------------
# Frontend — Vite (build-time variables, must be prefixed with VITE_)
# -----------------------------------------------------------------------------

# Base URL the browser uses to reach the API; in development this is localhost
VITE_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# CI/CD — GitHub Actions
# Set these in GitHub Actions secrets, not committed here.
# -----------------------------------------------------------------------------

# GitHub repository slug (owner/repo) used to tag Docker images on GHCR
# Example: your-org/restaurant-app
GITHUB_REPOSITORY=your-org/restaurant-app
